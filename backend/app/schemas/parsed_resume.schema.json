{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gemini Parsed Resume",
  "type": "object",
  "properties": {
    "candidate_info": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": { "type": "string" },
          "university": { "type": "string" },
          "year": { "type": "string" }
        }
      }
    },
    "work_experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": { "type": "string" },
          "role": { "type": "string" },
          "duration_years": { "type": "number" },
          "is_tech_company": { "type": "boolean" },
          "metrics_found": { 
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "hard_skills": { "type": "array", "items": { "type": "string" } },
        "soft_skills": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "years_of_experience": { "type": "number" },
        "job_hopping_risk": { "type": "string" },
        "career_growth": { "type": "string" },
        "summary": { "type": "string" }
      }
    }
  },
  "required": ["candidate_info", "skills", "analysis"]
}